{
  "name": "Commercial gym PPL",
  "unit": "lb",
  "days": [
    {
      "id": "push-a",
      "name": "Push A",
      "focus": "Chest",
      "exercises": [
        {
          "id": "bench-press",
          "name": "Barbell bench press",
          "sets": 4,
          "repMin": 5,
          "repMax": 8,
          "restSeconds": 180,
          "incrementLb": 5,
          "notes": "Last set stays at 1–2 RIR. Add load only when every set hits 8."
        },
        {
          "id": "incline-db-press",
          "name": "Incline dumbbell press",
          "sets": 3,
          "repMin": 8,
          "repMax": 12,
          "restSeconds": 120,
          "incrementLb": 5
        },
        {
          "id": "machine-shoulder-press",
          "name": "Machine shoulder press",
          "sets": 3,
          "repMin": 8,
          "repMax": 12,
          "restSeconds": 120,
          "incrementLb": 5
        },
        {
          "id": "lateral-raise-a",
          "name": "Dumbbell lateral raise",
          "sets": 3,
          "repMin": 12,
          "repMax": 15,
          "restSeconds": 60,
          "incrementLb": 2.5,
          "notes": "No swing. Soft elbows."
        },
        {
          "id": "cable-fly",
          "name": "Cable fly",
          "sets": 2,
          "repMin": 12,
          "repMax": 15,
          "restSeconds": 60,
          "incrementLb": 2.5
        },
        {
          "id": "triceps-pushdown-a",
          "name": "Triceps pushdown",
          "sets": 3,
          "repMin": 10,
          "repMax": 15,
          "restSeconds": 60,
          "incrementLb": 2.5
        },
        {
          "id": "overhead-triceps-a",
