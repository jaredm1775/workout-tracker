      "exercises": [
        {
          "id": "lat-pulldown-a",
          "name": "Lat pulldown or weighted pull-up",
          "sets": 4,
          "repMin": 6,
          "repMax": 10,
          "restSeconds": 150,
          "incrementLb": 5,
          "notes": "Use pull-ups if you can do 6+ clean reps."
        },
        {
          "id": "chest-supported-row-a",
          "name": "Chest-supported row",
          "sets": 3,
          "repMin": 8,
          "repMax": 12,
          "restSeconds": 120,
          "incrementLb": 5
