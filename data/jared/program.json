      "exercises": [
        {
          "id": "flat-machine-press",
          "name": "Flat machine press",
          "sets": 2,
          "repMin": 8,
          "repMax": 12,
          "restSeconds": 150,
          "incrementLb": 5,
          "progression": "topSet",
          "alternatives": [
            { "id": "flat-db-press", "name": "Flat dumbbell press" },
            { "id": "smith-flat-press", "name": "Flat Smith press", "notes": "Set the safety stoppers." }
          ]
        },
        {
          "id": "incline-smith-press",
          "name": "Incline Smith press",
          "sets": 2,
          "repMin": 8,
          "repMax": 12,
          "restSeconds": 150,
          "incrementLb": 5,
          "progression": "topSet",
